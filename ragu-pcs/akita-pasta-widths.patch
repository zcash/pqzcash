diff --git a/crates/akita-planner/examples/catalog_reprice.rs b/crates/akita-planner/examples/catalog_reprice.rs
new file mode 100644
index 0000000..80ddee2
--- /dev/null
+++ b/crates/akita-planner/examples/catalog_reprice.rs
@@ -0,0 +1,219 @@
+//! Re-price every checked-in schedule artifact at other field widths.
+//!
+//! For each generated schedule row this prints the planner's proof estimate
+//! at the schedule's own modulus, then the same schedule geometry priced as
+//! if its atoms were serialized over the Pallas base field (255-bit base and
+//! challenge field, no extension) and over Goldilocks (64-bit base field with
+//! a degree-2 challenge extension, as the fp64 presets use). The geometry is
+//! not re-planned: see `FieldWidthOverride` in `akita-schedules` for exactly
+//! what is and is not re-priced.
+//!
+//! Output is TSV on stdout. The breakdown columns split each total into the
+//! non-terminal direct payloads, offloaded setup sum-checks, the terminal
+//! extension-opening reduction, the terminal response, and grinding nonces.
+
+use std::env;
+use std::fmt::Write as _;
+use std::fs;
+use std::path::PathBuf;
+
+use akita_planner::generated_families::{GeneratedFamily, ALL_GENERATED_FAMILIES};
+use akita_schedules::{expanded_schedule_proof_breakdown, FieldWidthOverride, ProofEstimateBreakdown};
+
+/// Every atom at Pasta width: the schedule serialized over the Pallas base
+/// field with the commitment modulus equal to the field, as Akita does.
+const PALLAS: FieldWidthOverride = FieldWidthOverride {
+    base_field_bits: 255,
+    challenge_field_bits: 255,
+    claim_ext_degree: 1,
+    commitment_field_bits: None,
+};
+
+/// Pasta claim field, with commitment coordinates kept at their fp128 width.
+/// Commitment coordinates are SIS-sized in bits, so a native Pasta plan needs
+/// about half the rows of the fp128 geometry here; pricing them at 128 bits
+/// approximates that without changing the geometry.
+const PALLAS_SIS: FieldWidthOverride = FieldWidthOverride {
+    base_field_bits: 255,
+    challenge_field_bits: 255,
+    claim_ext_degree: 1,
+    commitment_field_bits: Some(128),
+};
+
+/// Pasta claim field with a 64-bit commitment modulus: inner images and
+/// compressed payloads at 8 bytes, partials and sum-check messages at 32.
+const PALLAS_Q64: FieldWidthOverride = FieldWidthOverride {
+    base_field_bits: 255,
+    challenge_field_bits: 255,
+    claim_ext_degree: 1,
+    commitment_field_bits: Some(64),
+};
+
+const GOLDILOCKS: FieldWidthOverride = FieldWidthOverride {
+    base_field_bits: 64,
+    challenge_field_bits: 128,
+    claim_ext_degree: 2,
+    commitment_field_bits: None,
+};
+
+fn usage() -> &'static str {
+    "usage: cargo run --release -p akita-planner --features catalog-gen \
+     --example catalog_reprice -- [--artifacts DIR] [family_name ...]\n\
+     --artifacts DIR reads `<family>.aks` files from DIR instead of the checked-in artifacts; \
+     families whose file is missing there are skipped"
+}
+
+fn selected_families(names: &[String]) -> Result<Vec<&'static GeneratedFamily>, String> {
+    if names.is_empty() {
+        return Ok(ALL_GENERATED_FAMILIES.iter().collect());
+    }
+    names
+        .iter()
+        .map(|name| {
+            ALL_GENERATED_FAMILIES
+                .iter()
+                .find(|family| family.family_name() == name)
+                .ok_or_else(|| format!("unknown generated schedule family {name:?}\n{}", usage()))
+        })
+        .collect()
+}
+
+fn logical_key(key: &akita_params::ScheduleLookupKey) -> String {
+    let mut logical = format!(
+        "final={}:{};precommitted=",
+        key.final_group.num_vars(),
+        key.final_group.num_polynomials(),
+    );
+    for (index, precommitted) in key.precommitteds.iter().enumerate() {
+        if index != 0 {
+            logical.push(',');
+        }
+        write!(
+            logical,
+            "{}:{}",
+            precommitted.group.num_vars(),
+            precommitted.group.num_polynomials(),
+        )
+        .expect("writing to String cannot fail");
+    }
+    logical
+}
+
+fn breakdown_columns(breakdown: &ProofEstimateBreakdown) -> String {
+    format!(
+        "{}\t{}\t{}\t{}\t{}\t{}",
+        breakdown.total(),
+        breakdown.nonterminal_direct_bytes,
+        breakdown.stage3_bytes,
+        breakdown.terminal_eor_bytes,
+        breakdown.terminal_response_bytes,
+        breakdown.nonce_max_bytes,
+    )
+}
+
+fn main() -> Result<(), String> {
+    let mut names = Vec::new();
+    let mut artifacts_dir: Option<PathBuf> = None;
+    let mut args = env::args().skip(1);
+    while let Some(arg) = args.next() {
+        match arg.as_str() {
+            "--help" | "-h" => {
+                println!("{}", usage());
+                return Ok(());
+            }
+            "--artifacts" => {
+                let value = args
+                    .next()
+                    .ok_or_else(|| format!("--artifacts requires a directory\n{}", usage()))?;
+                artifacts_dir = Some(PathBuf::from(value));
+            }
+            _ if arg.starts_with('-') => {
+                return Err(format!("unknown option {arg:?}\n{}", usage()));
+            }
+            _ => names.push(arg),
+        }
+    }
+    let explicit_artifacts = artifacts_dir.is_some();
+    let artifacts_dir = artifacts_dir.unwrap_or_else(|| {
+        PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../artifacts/schedules")
+    });
+
+    println!(
+        "family\tlogical_key\tfold_levels\tmodulus_profile\tbase_bits\tchallenge_bits\tclaim_ext_degree\
+         \toriginal_total\toriginal_nonterminal\toriginal_stage3\toriginal_terminal_eor\toriginal_terminal_response\toriginal_nonce\
+         \tpallas_total\tpallas_nonterminal\tpallas_stage3\tpallas_terminal_eor\tpallas_terminal_response\tpallas_nonce\
+         \tgoldilocks_total\tgoldilocks_nonterminal\tgoldilocks_stage3\tgoldilocks_terminal_eor\tgoldilocks_terminal_response\tgoldilocks_nonce\
+         \tpallas_sis_total\tpallas_sis_nonterminal\tpallas_sis_stage3\tpallas_sis_terminal_eor\tpallas_sis_terminal_response\tpallas_sis_nonce\
+         \tpallas_q64_total\tpallas_q64_nonterminal\tpallas_q64_stage3\tpallas_q64_terminal_eor\tpallas_q64_terminal_response\tpallas_q64_nonce"
+    );
+    let mut rows = 0usize;
+    for family in selected_families(&names)? {
+        let policy = (family.policy)();
+        let artifact_path = artifacts_dir.join(format!("{}.aks", family.family_name()));
+        if explicit_artifacts && !artifact_path.is_file() {
+            continue;
+        }
+        let bytes = fs::read(&artifact_path)
+            .map_err(|error| format!("read {}: {error}", artifact_path.display()))?;
+        let catalog = akita_schedules::ValidatedScheduleCatalog::from_artifact_bytes(
+            &bytes,
+            family.family_name(),
+            &policy,
+            family.ring_challenge_config,
+        )
+        .map_err(|error| format!("load {}: {error}", artifact_path.display()))?;
+        let challenge_bits = policy
+            .challenge_field_bits()
+            .map_err(|error| format!("{}: challenge field bits: {error}", family.family_name()))?;
+        for resolved in catalog.rows() {
+            let profiles = resolved.profiles();
+            let key = akita_params::ScheduleLookupKey {
+                final_group: profiles.final_group.group,
+                precommitteds: profiles.precommitteds.clone(),
+            };
+            let schedule = resolved.schedule();
+            let context = |what: &str| format!("{} {}: {what}", family.family_name(), logical_key(&key));
+            let original = expanded_schedule_proof_breakdown(&key, schedule, &policy, None)
+                .map_err(|error| context(&format!("original estimate: {error}")))?;
+            let expected = akita_schedules::expanded_schedule_proof_estimate_bytes(&key, schedule, &policy)
+                .map_err(|error| context(&format!("reference estimate: {error}")))?;
+            if original.total() != expected {
+                return Err(context(&format!(
+                    "breakdown total {} disagrees with the planner estimate {expected}",
+                    original.total()
+                )));
+            }
+            let pallas = expanded_schedule_proof_breakdown(&key, schedule, &policy, Some(PALLAS))
+                .map_err(|error| context(&format!("pallas re-pricing: {error}")))?;
+            let goldilocks =
+                expanded_schedule_proof_breakdown(&key, schedule, &policy, Some(GOLDILOCKS))
+                    .map_err(|error| context(&format!("goldilocks re-pricing: {error}")))?;
+            let pallas_sis =
+                expanded_schedule_proof_breakdown(&key, schedule, &policy, Some(PALLAS_SIS))
+                    .map_err(|error| context(&format!("pallas-sis re-pricing: {error}")))?;
+            let pallas_q64 =
+                expanded_schedule_proof_breakdown(&key, schedule, &policy, Some(PALLAS_Q64))
+                    .map_err(|error| context(&format!("pallas-q64 re-pricing: {error}")))?;
+            println!(
+                "{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}",
+                family.family_name(),
+                logical_key(&key),
+                schedule.num_fold_levels(),
+                policy.sis_modulus_profile.name(),
+                policy.decomposition.field_bits(),
+                challenge_bits,
+                policy.claim_ext_degree,
+                breakdown_columns(&original),
+                breakdown_columns(&pallas),
+                breakdown_columns(&goldilocks),
+                breakdown_columns(&pallas_sis),
+                breakdown_columns(&pallas_q64),
+            );
+            rows += 1;
+        }
+    }
+    if rows == 0 {
+        return Err("no generated schedule row matched the requested families".to_string());
+    }
+    Ok(())
+}
