+    /// Opens every slot the step did not query at ζ, as `ragu_pcd`'s adapter
+    /// does, and returns ζ, the six openings in slot order and the bridge
+    /// hash's coordinates.
+    #[cfg(feature = "test-utils")]
+    #[allow(clippy::type_complexity)]
+    pub(crate) fn finish(
+        mut self,
+        dr: &mut D,
+    ) -> Result<(
+        Element<'dr, D>,
+        [(Element<'dr, D>, Element<'dr, D>); 3 * HEADER_POLYNOMIALS],
+        [Element<'dr, D>; 2],
+    )> {
+        let zeta = self.zeta.clone();
+        for slot in Slot::all() {
+            if self.queries[slot.offset()].is_none() {
+                self.query(dr, slot, &zeta)?;
+            }
+        }
+        let queries = self
+            .queries
+            .map(|query| query.expect("every slot was queried"));
+        Ok((self.zeta, queries, self.bridge_hash))
+    }
 }
