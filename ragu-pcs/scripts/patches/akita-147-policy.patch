+/// Parse `AKITA_PRICING_WIDTHS=base_bits:challenge_bits:claim_ext_degree`.
+fn parse_pricing_widths(raw: &str) -> Result<akita_schedules::FieldWidthOverride, String> {
+    let parts: Vec<&str> = raw.split(':').collect();
+    let (base, challenge, ext, commitment) = match parts.as_slice() {
+        [base, challenge, ext] => (*base, *challenge, *ext, None),
+        [base, challenge, ext, commitment] => (*base, *challenge, *ext, Some(*commitment)),
+        _ => {
+            return Err(format!(
+                "AKITA_PRICING_WIDTHS must be `base_bits:challenge_bits:claim_ext_degree[:commitment_bits]`, got `{raw}`"
+            ));
+        }
+    };
+    let parse = |label: &str, value: &str| -> Result<u32, String> {
+        value
+            .parse::<u32>()
+            .ok()
+            .filter(|value| *value > 0)
+            .ok_or_else(|| format!("AKITA_PRICING_WIDTHS: invalid {label} `{value}`"))
+    };
+    Ok(akita_schedules::FieldWidthOverride {
+        base_field_bits: parse("base_bits", base)?,
+        challenge_field_bits: parse("challenge_bits", challenge)?,
+        claim_ext_degree: parse("claim_ext_degree", ext)? as usize,
+        commitment_field_bits: commitment
+            .map(|value| parse("commitment_bits", value))
+            .transpose()?,
+    })
+}
+
 fn main() -> Result<(), String> {
     let generation_started = Instant::now();
     let args = parse_args()?;
+    if let Some(raw) = env::var_os("AKITA_PRICING_WIDTHS") {
+        let widths = parse_pricing_widths(&raw.to_string_lossy())?;
+        akita_schedules::set_pricing_width_override(Some(widths));
+        eprintln!(
+            "pricing width override: base {} bits, challenge {} bits, claim extension degree {}, \
+             commitment {} bits; schedules are selected and priced at these widths, geometry \
+             stays the policy's",
+            widths.base_field_bits,
+            widths.challenge_field_bits,
+            widths.claim_ext_degree,
+            widths.commitment_bits()
+        );
+    }
     validate_explicit_output_isolation(&args.base_dir, &args.explicit_rows)?;
     fs::create_dir_all(&args.base_dir)
         .map_err(|e| format!("create {}: {e}", args.base_dir.display()))?;
